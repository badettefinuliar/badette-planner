rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      // Membership is managed only through the console or a trusted Admin SDK.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /buyers/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      // Only access metadata may change; no passwords or financial fields.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'allowedProducts'])
        && request.resource.data.keys().hasOnly(['email', 'status', 'allowedProducts'])
        && request.resource.data.email is string
        && request.resource.data.status in ['pending', 'approved', 'revoked']
        && request.resource.data.allowedProducts is list
        && request.resource.data.allowedProducts.size() <= 50;
      // Self-signup grants pending access only, never approval or products.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasAll(['email', 'status', 'allowedProducts'])
        && request.resource.data.keys().hasOnly(['email', 'status', 'allowedProducts'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.allowedProducts is list
        && request.resource.data.allowedProducts.size() == 0;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
